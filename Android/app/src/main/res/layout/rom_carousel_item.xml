<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:padding="6dp">

    <!-- 452:701 cover plus a reflection 0.3 of its height (701 * 1.3 = 911). -->
    <com.izzy2lost.neshd.ReflectedCoverView
        android:id="@+id/romCoverImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Game cover"
        android:src="@drawable/no_cover_placeholder"
        app:layout_constraintDimensionRatio="452:911"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/romGridHdPackIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="HD pack installed"
        android:src="@drawable/hd_24px"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/romCoverImage"
        app:layout_constraintTop_toTopOf="@id/romCoverImage" />

    <TextView
        android:id="@+id/romGridName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textColor="@color/library_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/romCoverImage" />

</androidx.constraintlayout.widget.ConstraintLayout>
